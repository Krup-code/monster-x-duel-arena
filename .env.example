# MONSTER-X: DUEL ARENA - build-time configuration
# ------------------------------------------------------------------------------------------
# Copy to .env.local (git-ignored) and fill in what you need. EVERY value is optional:
# with this file absent the game uses the free public PeerJS broker (0.peerjs.com) for
# matchmaking/signaling and Google + Cloudflare STUN for NAT traversal.
#
# These are VITE_* variables, so Vite inlines them into the client bundle at build time.
# Anything you put here is visible to every player who opens the site; never put
# admin credentials or private server secrets in it.
#
# On GitHub Pages, set the same names as repository variables or secrets
# (Settings -> Secrets and variables -> Actions); .github/workflows/deploy.yml passes them in.

# ---- Hosting ------------------------------------------------------------------------------
# Public base path. Leave blank for './' (relative), which works from a domain root, from any
# GitHub Pages project folder (https://USER.github.io/REPO/) and with ?room=CODE invite links.
VITE_BASE=

# ---- Signaling backend selection ---------------------------------------------------------
# Blank   -> Firebase if VITE_FIREBASE_API_KEY + VITE_FIREBASE_DATABASE_URL are set, else PeerJS.
# peerjs  -> force PeerJS even when Firebase is configured.
# (Players can also force it per session with the URL parameter ?signaling=peerjs .)
VITE_SIGNALING=

# ---- Firebase Realtime Database signaling (optional) ---------------------------------------
# Leave ALL of these blank to use the zero-config PeerJS public broker instead.
# Setup guide, security rules and what is safe to expose: firebase/README.md
# The Firebase web config is public by design; access is controlled by
# firebase/database.rules.json + Anonymous Authentication.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
# e.g. https://your-project-default-rtdb.firebaseio.com
#  or  https://your-project-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ---- TURN relay (optional, for strict / symmetric NATs) -------------------------------------
# STUN alone connects most home networks. Corporate, campus and some mobile (CGNAT) networks
# need a TURN relay. Options: Cloudflare Calls TURN, Metered.ca, Twilio, or self-hosted coturn.
# VITE_TURN_URLS is a comma-separated list, for example:
#   turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# The username/credential ship inside the client bundle: use a dedicated, usage-capped TURN
# account (or credentials you rotate), never a master key.
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# ---- PeerJS broker (optional; default is the public 0.peerjs.com cloud on port 443) --------
# Self-hosted broker: `npm run signal` starts one on localhost:9000 (path '/'), which runs the
# `peerjs` CLI from the `peer` npm package (`npx peer --port 9000 --path /` works too).
# localhost / 127.0.0.1 automatically use port 9000 and an insecure ws:// connection, so for
# local development VITE_PEERJS_HOST=localhost is all you need.
# At runtime the URL parameters ?signal=HOST&signalPort=PORT&signalInsecure override these,
# and invite links keep them so both players use the same broker.
VITE_PEERJS_HOST=
# Default: 443 (or 9000 for localhost)
VITE_PEERJS_PORT=
# Default: /
VITE_PEERJS_PATH=
# Default: peerjs
VITE_PEERJS_KEY=
# true / false. Default: true (false for localhost)
VITE_PEERJS_SECURE=
